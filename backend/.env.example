# 服务端口
PORT=3000

# JWT 密钥 —— 请修改为随机长字符串
JWT_SECRET=please-change-this-to-a-long-random-string

# DeepSeek API Key
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# SiliconFlow API Key（备用）
SILICONFLOW_API_KEY=your-siliconflow-api-key-here

# CORS 允许的前端源（逗号分隔）
# 开发环境默认：http://localhost:8080,http://localhost:5173
# 生产环境请改为实际域名，如：https://yourdomain.com
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# 管理员初始账号（创建管理员脚本使用，非必须）
# 用法：设置后运行 node scripts/create-admin.js 即可创建
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NICKNAME=管理员
